{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build pemdas_calculator",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-g",
                "${workspaceFolder}\\pemdas_calculator.cpp",
                "-o",
                "${workspaceFolder}\\pemdas_calculator.exe"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
